{
  "name": "actdown",
  "version": "0.1.0",
  "description": "MCP reader mode for agents: transcode web pages to canonical actdown documents and JSON ASTs",
  "keywords": [
    "markdown",
    "agents",
    "mcp",
    "model-context-protocol",
    "document-format",
    "html-to-markdown",
    "llm",
    "ai"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./serve": {
      "types": "./dist/serve.d.ts",
      "default": "./dist/serve.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Omodaka9375/actdown.git"
  },
  "bugs": {
    "url": "https://github.com/Omodaka9375/actdown/issues"
  },
  "homepage": "https://actdown.dev/",
  "bin": {
    "actdown": "dist/cli.js",
    "actdown-mcp": "dist/mcp.js",
    "actdown-edge": "dist/serve.js"
  },
  "files": [
    "dist",
    "SPEC.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "verify": "node scripts/verify.mjs",
    "test:mcp": "node scripts/mcp-smoke.mjs",
    "test:entrypoints": "node scripts/check-entrypoints.mjs",
    "prepack": "pnpm build",
    "verify:rs": "cargo test --manifest-path actdown-rs/Cargo.toml",
    "edge": "node dist/serve.js",
    "demo": "node examples/mcp-approval/demo.mjs",
    "cli": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "ws": "^8.18.0"
  }
}
