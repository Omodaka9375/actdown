{
  "name": "actdown",
  "version": "0.1.0",
  "description": "Actionable Markdown for agents and humans (spec draft 0.1)",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Omodaka9375/actdown.git"
  },
  "bugs": {
    "url": "https://github.com/Omodaka9375/actdown/issues"
  },
  "homepage": "https://github.com/Omodaka9375/actdown#readme",
  "bin": {
    "actdown": "dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "verify": "node scripts/verify.mjs",
    "verify:rs": "cargo test --manifest-path actdown-rs/Cargo.toml",
    "edge": "node dist/serve.js",
    "demo": "node examples/mcp-approval/demo.mjs",
    "cli": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "ws": "^8.18.0"
  }
}
